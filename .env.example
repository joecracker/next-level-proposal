# AI_API_KEY: Required for AI API calls (the AI formatting layer).
# Set this in Cloudflare Pages → Settings → Environment variables (never commit it).
# Users can also supply their own key in-app.
AI_API_KEY="YOUR_AI_API_KEY"

# VITE_GOOGLE_CLIENT_ID: OAuth Client ID for Google Drive backup (see GOOGLE_DRIVE_SETUP.md).
# Public identifier, not a secret. Leave blank to disable Drive backup (local export/import still works).
VITE_GOOGLE_CLIENT_ID=""