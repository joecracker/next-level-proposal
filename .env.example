# GEMINI_API_KEY: Required for AI calls (the AI formatting / import layer).
# Set this in Cloudflare (Workers & Pages -> your project -> Settings ->
# Variables and Secrets) as a secret. Never commit the real value.
# The server also still accepts the older name AI_API_KEY, which earlier
# instructions used by mistake. Prefer GEMINI_API_KEY.
GEMINI_API_KEY=your-key-here

# VITE_GOOGLE_CLIENT_ID: OAuth Client ID for Google Drive backup (see GOOGLE_DRIVE_SETUP.md).
# Public identifier, not a secret. Leave blank to disable Drive backup (local export/import still works).
VITE_GOOGLE_CLIENT_ID=""
